{
  "require": {
      "php": ">=8.1",
      "behat/behat": "^3.14",
      "php-webdriver/webdriver": "^1.15",
      "symfony/yaml": "^6.4 || ^7.0"
  },
  "scripts": {
    "test": [
      "@single",
      "@parallel"
    ],
    "single": "behat --config=config/single.conf.yml",
    "parallel": "@php lib/parallel.php config/parallel.conf.yml"
  },
  "autoload": {
    "classmap": ["lib/", "features/bootstrap/"]
  }
}
